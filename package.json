{
  "name": "jdz-low-altitude-agent-lab",
  "version": "2.6.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node scripts/start-production.mjs",
    "test": "pnpm run build && pnpm run test:runtime && pnpm run eval:rag && pnpm run eval:rag:center && pnpm run eval:four",
    "test:runtime": "node --test tests/reliability.test.mjs tests/runtime-architecture.test.mjs tests/r0-foundation.test.mjs tests/four-agent-scope.test.mjs tests/four-agent-baseline.test.mjs tests/rag-foundation.test.mjs tests/knowledge-admin.test.mjs tests/rag-evaluation-center.test.mjs tests/flagship-demo.test.mjs tests/ag001-depth.test.mjs tests/ag012-depth.test.mjs tests/ag025-depth.test.mjs tests/ag027-depth.test.mjs tests/client-copy.test.mjs tests/production-start.test.mjs app/lib/agents/ag001/tests/r0-module.test.mjs app/lib/agents/ag012/tests/r0-module.test.mjs app/lib/agents/ag025/tests/r0-module.test.mjs app/lib/agents/ag027/tests/r0-module.test.mjs",
    "test:r0": "node --test tests/r0-foundation.test.mjs tests/runtime-architecture.test.mjs tests/four-agent-scope.test.mjs app/lib/agents/ag001/tests/r0-module.test.mjs app/lib/agents/ag012/tests/r0-module.test.mjs app/lib/agents/ag025/tests/r0-module.test.mjs app/lib/agents/ag027/tests/r0-module.test.mjs",
    "audit:r0-migration": "node scripts/audit-r0-agent-migration.mjs",
    "test:flagship": "pnpm run build && node --test tests/flagship-demo.test.mjs",
    "test:knowledge": "node --test tests/knowledge-admin.test.mjs",
    "test:evaluation": "node --test tests/rag-evaluation-center.test.mjs",
    "test:rag": "node --test tests/rag-foundation.test.mjs",
    "verify:deepseek": "pnpm run build && node --env-file=.env.local scripts/verify-deepseek.mjs",
    "verify:embedding": "node --env-file=.env.local scripts/verify-embedding.mjs",
    "verify:rag-safety": "node --env-file=.env.local scripts/verify-rag-safety.mjs",
    "eval:rag": "node scripts/run-rag-evals.mjs && node scripts/run-rag-agent-evals.mjs",
    "eval:rag:center": "node scripts/run-rag-evaluation-center.mjs",
    "eval:four": "node scripts/run-four-agent-evals.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint app worker tests scripts",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

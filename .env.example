# Set every runnable Agent provider to "production" before enabling
# AGENT_RUNTIME_MODE=production. Production mode refuses Demo providers.
# The two upstream services must implement docs/PRODUCTION_ADAPTER_CONTRACT.md.
JDZ_AI_PLATFORM_BASE_URL=
JDZ_AI_PLATFORM_AUTH_TOKEN=
JDZ_BUSINESS_DATA_BASE_URL=
JDZ_BUSINESS_DATA_AUTH_TOKEN=
JDZ_KNOWLEDGE_SEARCH_BASE_URL=
JDZ_KNOWLEDGE_SEARCH_AUTH_TOKEN=
JDZ_BUSINESS_ACTION_BASE_URL=
JDZ_BUSINESS_ACTION_AUTH_TOKEN=
JDZ_CONVERSATION_RETENTION_DAYS=30
JDZ_AGENT_RUN_RETENTION_DAYS=180
JDZ_TENANT_REQUESTS_PER_MINUTE=300
JDZ_SUBJECT_AGENT_REQUESTS_PER_MINUTE=30
JDZ_TENANT_AGENT_REQUESTS_PER_MONTH=100000
JDZ_IDEMPOTENCY_RETENTION_HOURS=24
JDZ_AGENT_TASK_RETENTION_HOURS=72
JDZ_CALLBACK_RETENTION_HOURS=72
JDZ_MAX_AGENT_INPUT_CHARACTERS=8000
JDZ_MAX_URLS_PER_REQUEST=8

# Production only. The trusted gateway must strip inbound x-jdz-* headers,
# inject its verified identity context, and sign the method, path/query, body,
# Idempotency-Key, Prefer and X-JDZ-Callback-Id control headers. A nonce is one-time use.
# Production roles must include one of: agent-user, buyer, operator,
# customer-service or admin.
JDZ_GATEWAY_SHARED_SECRET=
JDZ_AUTH_MAX_CLOCK_SKEW_SECONDS=300

# Demo-only knowledge ingestion credential. Use at least 24 random characters.
# Production ignores this value and requires a signed admin/knowledge-admin identity.
JDZ_DEMO_RAG_ADMIN_TOKEN=

# Temporary provider-neutral RAG foundation. Keep MODEL, EMBEDDING and RERANK
# separately configurable; DeepSeek chat does not provide an embedding model.
RAG_RUNTIME_MODE=local
MODEL_PROVIDER=disabled
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=20000
# Qwen example: provider=qwen, model=text-embedding-v4. Its base URL defaults
# to the DashScope OpenAI-compatible endpoint when left empty.
EMBEDDING_PROVIDER=disabled
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_MAX_BATCH=10
# Use qwen for DashScope gte-rerank-v2. When RERANK_API_KEY is empty,
# the server reuses EMBEDDING_API_KEY; no credential is exposed to clients.
RERANK_PROVIDER=local
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT_MS=15000
RAG_RETRIEVE_K=20
RAG_RERANK_K=10
RAG_CONTEXT_K=6
RAG_RRF_K=60
RAG_MIN_EVIDENCE=1
RAG_MAX_INDEX_VERSIONS=20
RAG_MAX_CHUNKS_PER_NAMESPACE=10000
RAG_MAX_TOTAL_CHUNKS=100000
